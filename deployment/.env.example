# Copy to deployment/.env (gitignored) and fill in.

# Public URL that serves R2_BUCKET/R2_PREFIX. Baked into the uploaded install.sh.
PUBLIC_URL=https://s3.ianhuang.dev/cue

R2_BUCKET=public
R2_PREFIX=cue

# Either name an existing rclone remote for the R2 account...
RCLONE_REMOTE=
# ...or leave it empty and give an R2 API token (R2 > Manage API tokens,
# "Object Read & Write" on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
